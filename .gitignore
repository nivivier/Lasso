# === Données sensibles (PII employés) — ne JAMAIS versionner ===
# « /data/* » et non « /data/ » : git refuse de réinclure un fichier dont un
# dossier parent est exclu, donc le « !/data/.htaccess » ci-dessous n'aurait
# aucun effet avec la forme « /data/ ». Même construction que /uploads/* plus
# bas. Ce .htaccess (Require all denied) DOIT être versionné : sans lui, une
# installation neuve laisse data/ sans protection — le dossier est créé par un
# simple mkdir() dans db(), et le .htaccess racine ne bloque pas les .bak/.log
# qu'on y trouve (sauvegardes de base, journal d'e-mails).
/data/*
!/data/.htaccess
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.bak

# === Fichiers uploadés (logos…) sauf la protection .htaccess ===
/uploads/*
!/uploads/.htaccess

# === Configuration locale / secrets de production ===
/lib/config.local.php

# === Journaux ===
*.log

# === Décomptes / exports (PII) — ne JAMAIS versionner ===
*.xlsx
*.xls
*.csv
*.ods
# Exception : fichier d'exemple statique servi depuis l'aide de l'import
# événements (views/import_fiches.php), sans donnée réelle — doit être versionné.
!/assets/exemples/*.csv

# === Notes de spécification locales (pas encore implémentées) ===
/SPEC_FACTURATION.md

# === Outils locaux & OS ===
.claude/settings.local.json
.DS_Store
**/.DS_Store
import/
